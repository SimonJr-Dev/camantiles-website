# Copy to .env.local for a real deployment. Local development needs none of
# these: `npm run dev` starts its own database and uses built-in defaults.

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/database

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public address of the site, without a trailing slash.
BETTER_AUTH_URL=https://example.gov.ph
NEXT_PUBLIC_SITE_URL=https://example.gov.ph

# First account, used once by `npm run db:seed`.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
